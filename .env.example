# Produção — preencha no painel da hospedagem; não versione valores reais.
NODE_ENV=production
PORT=3000
DATABASE_URL=mysql://USUARIO:SENHA@HOST:3306/NOME_DO_BANCO

# Mercado Pago — configure no painel da hospedagem, nunca no GitHub.
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
PUBLIC_APP_URL=https://seudominio.com.br

# Autenticação Manus/OAuth
MANUS_PROJECT_ID=
MANUS_JWT_SECRET=
MANUS_OAUTH_API_URL=
MANUS_OAUTH_PORTAL_URL=
OWNER_OPEN_ID=

# APIs server-side da plataforma
MANUS_API_URL=
MANUS_API_KEY=

# Valor público usado apenas pelo navegador, se o projeto exigir
MANUS_API_BROWSER_KEY=
